:root{--bleu:#1F4E79;--bleu2:#2E6DA4;--fond:#F4F6F9;--carte:#fff;--txt:#1D2939;--gris:#667085;--bord:#D0D5DD;--vert:#1B7F3B;--rouge:#B42318;--orange:#B54708}
*{box-sizing:border-box}
body{margin:0;font-family:"Segoe UI",Roboto,Arial,sans-serif;background:var(--fond);color:var(--txt);font-size:14.5px}
a{color:var(--bleu2);text-decoration:none}a:hover{text-decoration:underline}
header.top{background:var(--bleu);color:#fff;display:flex;align-items:center;gap:18px;padding:0 20px;min-height:54px;flex-wrap:wrap}
header.top .marque{font-weight:700;font-size:17px;color:#fff;white-space:nowrap}
header.top nav{display:flex;gap:2px;flex-wrap:wrap;flex:1}
header.top nav a{color:#DCE6F2;padding:17px 10px;display:block}
header.top nav a.actif,header.top nav a:hover{color:#fff;background:rgba(255,255,255,.1);text-decoration:none}
header.top .user{font-size:13px;color:#DCE6F2;white-space:nowrap}header.top .user a{color:#fff}
main{max-width:1250px;margin:0 auto;padding:22px 20px 60px}
h1{font-size:22px;margin:0 0 4px}h2{font-size:17px;margin:26px 0 10px}
.sous{color:var(--gris);margin:0 0 18px}
.carte{background:var(--carte);border:1px solid var(--bord);border-radius:10px;padding:18px;margin-bottom:18px}
.grille{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:14px;margin-bottom:18px}
.kpi{background:#fff;border:1px solid var(--bord);border-radius:10px;padding:14px 16px}
.kpi .l{color:var(--gris);font-size:12.5px;text-transform:uppercase;letter-spacing:.03em}
.kpi .v{font-size:24px;font-weight:700;margin-top:4px}
.kpi .d{color:var(--gris);font-size:12.5px}
table.t{width:100%;border-collapse:collapse;background:#fff}
table.t th,table.t td{padding:8px 10px;border-bottom:1px solid #EAECF0;text-align:left;vertical-align:middle}
table.t th{background:#F9FAFB;font-size:12.5px;color:#475467;text-transform:uppercase;letter-spacing:.02em}
table.t tr:hover td{background:#FAFBFD}
.num{text-align:right!important;font-variant-numeric:tabular-nums}
.c{text-align:center!important}
.tw{overflow-x:auto;border:1px solid var(--bord);border-radius:10px}
.btn{display:inline-block;padding:8px 14px;border-radius:7px;border:1px solid var(--bleu);background:var(--bleu);color:#fff;cursor:pointer;font-size:14px;font-family:inherit}
.btn:hover{background:var(--bleu2);text-decoration:none}
.btn.sec{background:#fff;color:var(--bleu)}.btn.sec:hover{background:#EEF4FA}
.btn.danger{background:var(--rouge);border-color:var(--rouge)}
.btn.petit{padding:4px 9px;font-size:13px}
.actions{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
.entete{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;flex-wrap:wrap;margin-bottom:14px}
form.f label{display:block;font-weight:600;font-size:13px;margin:10px 0 4px}
input,select,textarea{font:inherit;padding:7px 9px;border:1px solid var(--bord);border-radius:6px;background:#fff;width:100%}
input[type=checkbox]{width:auto}
.ligne{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:0 16px}
.filtres{display:flex;gap:8px;flex-wrap:wrap;align-items:end;margin-bottom:14px}
.filtres>*{width:auto}
.flash{padding:10px 14px;border-radius:8px;margin-bottom:10px;border:1px solid}
.flash.success{background:#ECFDF3;border-color:#ABEFC6;color:#067647}
.flash.danger{background:#FEF3F2;border-color:#FECDCA;color:var(--rouge)}
.flash.warning{background:#FFFAEB;border-color:#FEDF89;color:var(--orange)}
.flash.info{background:#EFF8FF;border-color:#B2DDFF;color:#175CD3}
.badge{display:inline-block;padding:2px 8px;border-radius:20px;font-size:12px;font-weight:600;background:#F2F4F7;color:#344054}
.badge.ok{background:#ECFDF3;color:#067647}.badge.ko{background:#FEF3F2;color:var(--rouge)}.badge.att{background:#FFFAEB;color:var(--orange)}
.rouge{color:var(--rouge)}.vert{color:var(--vert)}.gris{color:var(--gris)}
.photo{width:96px;height:120px;object-fit:cover;border-radius:8px;border:1px solid var(--bord);background:#F2F4F7}
.fiche{display:grid;grid-template-columns:auto 1fr;gap:18px}
dl.info{display:grid;grid-template-columns:170px 1fr;gap:6px 12px;margin:0}dl.info dt{color:var(--gris)}dl.info dd{margin:0;font-weight:500}
table.saisie td,table.saisie th{padding:4px 5px}
table.saisie input{width:58px;text-align:center;padding:5px 3px}
table.saisie input.bas{color:var(--rouge);font-weight:600}
table.saisie input.disp{background:#F2F4F7}
table.saisie th.v{writing-mode:vertical-rl;transform:rotate(180deg);height:170px;text-transform:none;font-size:12px;white-space:normal;line-height:1.15;text-align:left!important}
.sticky{position:sticky;left:0;background:#fff;z-index:1}
.login{max-width:380px;margin:9vh auto}
.aide{font-size:13px;color:var(--gris)}
.progress{height:8px;background:#EAECF0;border-radius:5px;overflow:hidden;margin-top:8px}.progress>div{height:100%;background:var(--vert)}
@media(max-width:700px){.fiche{grid-template-columns:1fr}dl.info{grid-template-columns:1fr}header.top nav a{padding:10px 8px}}
@media print{header.top,.actions,.btn,.filtres{display:none!important}body{background:#fff}.carte{border:none}}
/* ---- en-tête adaptable (PC / tablette / téléphone) ---- */
header.top{padding-top:env(safe-area-inset-top,0px);position:sticky;top:0;z-index:20}
header.top nav{align-items:center}
header.top nav .user{margin-left:auto;padding:0 4px}
.menu-btn{display:none;background:transparent;border:1px solid rgba(255,255,255,.35);color:#fff;border-radius:7px;padding:6px 12px;font:inherit;cursor:pointer;margin-left:auto}
.bandeau{display:flex;gap:10px;align-items:center;flex-wrap:wrap;background:#EFF8FF;border-bottom:1px solid #B2DDFF;color:#175CD3;padding:10px 20px;font-size:14px}
.bandeau[hidden]{display:none}
@media(max-width:900px){
  header.top{padding:0 14px}
  header.top .marque{padding:14px 0}
  .menu-btn{display:block}
  header.top nav{display:none;flex-basis:100%;flex-direction:column;align-items:stretch;padding-bottom:10px}
  header.top nav.ouvert{display:flex}
  header.top nav a{padding:11px 8px;border-radius:6px}
  header.top nav .user{margin:8px 0 0;padding:10px 8px;border-top:1px solid rgba(255,255,255,.2);white-space:normal;line-height:2}
  header.top nav .user a{display:inline;padding:0;background:none}
  main{padding:16px 14px 50px}
  h1{font-size:20px}
  .entete .actions{width:100%}
  input,select,textarea{font-size:16px} /* évite le zoom automatique sur iPhone */
  .btn{padding:10px 14px}
}
@media(display-mode:standalone){header.top{box-shadow:0 1px 0 rgba(0,0,0,.1)}}
/* ---- v1.2 : maternelle, menus, nouveaux modules ---- */
table.saisie select.appr{width:66px;padding:4px 2px;text-align:center;font-weight:600}
.appr-A{background:#ECFDF3;color:#067647}.appr-ECA{background:#FFFAEB;color:#B54708}.appr-NA{background:#FEF3F2;color:#B42318}.appr-D{background:#F2F4F7}
table.saisie input.obs{width:260px;text-align:left;padding:5px 7px}
details.groupe{position:relative}
details.groupe>summary{list-style:none;color:#DCE6F2;padding:17px 10px;cursor:pointer;white-space:nowrap}
details.groupe>summary::-webkit-details-marker{display:none}
details.groupe>summary::after{content:" ▾";font-size:11px}
details.groupe[open]>summary,details.groupe>summary:hover,details.groupe.actif>summary{color:#fff;background:rgba(255,255,255,.1)}
details.groupe .sous-menu{position:absolute;top:100%;left:0;background:#fff;border:1px solid var(--bord);border-radius:8px;box-shadow:0 8px 24px rgba(16,24,40,.14);min-width:210px;padding:6px;z-index:30}
header.top details.groupe .sous-menu a{color:var(--txt);padding:9px 12px;border-radius:6px;display:block}
header.top details.groupe .sous-menu a:hover,header.top details.groupe .sous-menu a.actif{background:#EEF4FA;color:var(--bleu);text-decoration:none}
.pastille{display:inline-block;min-width:18px;padding:0 5px;border-radius:9px;background:#F04438;color:#fff;font-size:11px;font-weight:700;text-align:center;margin-left:4px}
.grille2{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:18px}
.wa{background:#25D366;border-color:#25D366;color:#fff}.wa:hover{background:#1DA851}
.statut-present{background:#ECFDF3}.statut-absent{background:#FEF3F2}.statut-retard{background:#FFFAEB}
.choix-appel{display:flex;gap:4px;flex-wrap:wrap}
.choix-appel label{border:1px solid var(--bord);border-radius:6px;padding:5px 10px;cursor:pointer;font-size:13px;background:#fff}
.choix-appel input{display:none}
.choix-appel label:has(input:checked){font-weight:700}
.choix-appel label.p:has(input:checked){background:#ECFDF3;border-color:#ABEFC6;color:#067647}
.choix-appel label.a:has(input:checked){background:#FEF3F2;border-color:#FECDCA;color:#B42318}
.choix-appel label.r:has(input:checked){background:#FFFAEB;border-color:#FEDF89;color:#B54708}
.barre{height:10px;border-radius:5px;background:#EAECF0;overflow:hidden;min-width:80px}
.barre>i{display:block;height:100%}
.enfant{border:1px solid var(--bord);border-radius:10px;padding:16px;background:#fff;margin-bottom:16px}
@media(max-width:900px){
  details.groupe>summary{padding:11px 8px}
  details.groupe .sous-menu{position:static;box-shadow:none;border:none;background:rgba(255,255,255,.06);min-width:0}
  header.top details.groupe .sous-menu a{color:#DCE6F2}
  header.top details.groupe .sous-menu a:hover,header.top details.groupe .sous-menu a.actif{background:rgba(255,255,255,.12);color:#fff}
}
header.top.parent{background:#1B5E3B}
header.top nav .user{white-space:nowrap;font-size:13px;color:#DCE6F2}
header.top nav .user a{display:inline;padding:0;background:none;color:#fff}
header.top nav .user a:hover{text-decoration:underline;background:none}
@media(max-width:1180px) and (min-width:901px){header.top nav a,details.groupe>summary{padding:17px 7px;font-size:14px}}
/* ---- v1.3 : menu latéral fixe + zone de travail ---- */
.app{min-height:100vh}
.lateral{position:fixed;top:0;left:0;bottom:0;width:260px;background:#12324F;color:#DCE6F2;display:flex;flex-direction:column;z-index:40;overflow:hidden;padding-top:env(safe-area-inset-top,0px)}
.lateral .marque{display:flex;gap:10px;align-items:center;padding:14px 16px;color:#fff;font-weight:700;font-size:17px;border-bottom:1px solid rgba(255,255,255,.1);text-decoration:none}
.lateral .marque small{display:block;font-weight:500;font-size:11.5px;color:#9FB6CE;max-width:170px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.logo-g{width:34px;height:34px;border-radius:9px;background:linear-gradient(135deg,#2E6DA4,#1B7F3B);display:grid;place-items:center;font-size:18px}
.choix-ecole{padding:8px 14px;border-bottom:1px solid rgba(255,255,255,.1)}
.choix-ecole .aide{color:#9FB6CE;font-size:11px}
.choix-ecole select{background:#0E2840;color:#fff;border-color:#2B4C6C;padding:5px 7px;font-size:13px}
.lateral nav{flex:1;overflow-y:auto;padding:8px 8px 20px;display:block}
.lateral nav a{display:flex;align-items:center;gap:8px;color:#C9D7E6;padding:8px 10px;border-radius:7px;font-size:14px;text-decoration:none}
.lateral nav a:hover{background:rgba(255,255,255,.07);color:#fff}
.lateral nav a.actif{background:#2E6DA4;color:#fff;font-weight:600}
.lateral .ico{width:20px;text-align:center;flex:none;font-size:14px}
details.groupe-l>summary{list-style:none;display:flex;align-items:center;gap:8px;padding:9px 10px;border-radius:7px;cursor:pointer;color:#E8EEF5;font-weight:600;font-size:14px}
details.groupe-l>summary::-webkit-details-marker{display:none}
details.groupe-l>summary::after{content:"▸";margin-left:auto;font-size:11px;transition:transform .15s}
details.groupe-l[open]>summary::after{transform:rotate(90deg)}
details.groupe-l>summary:hover{background:rgba(255,255,255,.07)}
details.groupe-l.actif>summary{color:#fff}
details.groupe-l .sous{padding:2px 0 6px 28px}
details.groupe-l .sous a{font-size:13.5px;padding:6px 10px}
.lateral-pied{padding:8px 16px;border-top:1px solid rgba(255,255,255,.1);color:#7F97B0!important;font-size:11.5px}
.zone{margin-left:260px;min-width:0}
.barre-haut{position:sticky;top:0;z-index:30;height:56px;background:#fff;border-bottom:1px solid var(--bord);display:flex;align-items:center;gap:14px;padding:0 20px;box-shadow:0 1px 3px rgba(16,24,40,.05)}
.bh-titre{display:flex;flex-direction:column;line-height:1.2;min-width:0}
.bh-titre strong{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.bh-user{margin-left:auto;font-size:13px;white-space:nowrap}
.btn-menu{display:none;background:none;border:1px solid var(--bord);border-radius:7px;font-size:20px;padding:2px 10px;cursor:pointer;color:var(--bleu)}
main.travail{max-width:none;margin:0;padding:20px 24px 60px}
.indicateurs{position:sticky;top:56px;z-index:20;background:var(--fond);padding:8px 0 10px;margin-top:-8px}
.voile{position:fixed;inset:0;background:rgba(16,24,40,.45);z-index:35}
.voile[hidden]{display:none}
@media(max-width:1000px){
  .lateral{transform:translateX(-100%);transition:transform .2s;box-shadow:0 0 30px rgba(0,0,0,.3)}
  .lateral.ouvert{transform:none}
  .zone{margin-left:0}
  .btn-menu{display:block}
  .bh-user{font-size:12px}
  .bh-user .badge{display:none}
  main.travail{padding:14px 12px 50px}
}
@media(max-width:600px){.bh-user{display:none}.indicateurs{position:static}}
@media print{.lateral,.barre-haut,.voile,.sig-actions,.pc-actions,.barre-doc{display:none!important}.zone{margin:0}main.travail{padding:0}.indicateurs{position:static}}
/* composants */
.barre-doc{display:flex;flex-wrap:wrap;gap:6px;align-items:center;padding:10px;background:#fff;border:1px solid var(--bord);border-radius:10px;margin-bottom:14px;position:sticky;top:64px;z-index:15}
.barre-doc .sep{width:1px;height:26px;background:var(--bord);margin:0 4px}
.btn.vert{background:var(--vert);border-color:var(--vert);color:#fff}.btn.orange{background:#B54708;border-color:#B54708}
.sig-pad{border:1px dashed #98A2B3;border-radius:10px;padding:10px;background:#FCFCFD;max-width:500px}
.sig-pad canvas{width:100%;height:auto;background:#fff;border:1px solid #EAECF0;border-radius:6px;touch-action:none;cursor:crosshair;display:block}
.sig-titre{font-weight:600;font-size:13px;margin-bottom:6px}
.sig-actions{display:flex;gap:6px;align-items:center;margin-top:6px;flex-wrap:wrap}
.sig-apercu{margin-top:6px}.sig-apercu img{max-width:220px;border:1px solid #EAECF0;border-radius:6px;background:#fff}
.photo-capture{display:inline-flex;flex-direction:column;gap:6px;align-items:center}
.pc-cadre{width:120px;height:150px;border:2px dashed #98A2B3;border-radius:8px;display:grid;place-items:center;overflow:hidden;cursor:pointer;background:#F9FAFB;text-align:center;font-size:12px;color:var(--gris)}
.pc-cadre img,.pc-cadre video{width:100%;height:100%;object-fit:cover}
.pc-actions{display:flex;gap:4px;flex-wrap:wrap;justify-content:center}
.toast{position:fixed;right:18px;bottom:18px;z-index:99;padding:10px 16px;border-radius:8px;color:#fff;background:#067647;box-shadow:0 8px 24px rgba(0,0,0,.2);opacity:0;transform:translateY(10px);transition:.2s}
.toast.ko{background:var(--rouge)}.toast.vu{opacity:1;transform:none}
.grille-id{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:4px 14px}
.grille-id label{font-weight:600;font-size:12.5px;margin:6px 0 3px;display:block}
.duo{display:flex;gap:6px}.duo select{width:130px;flex:none}
table.t.compact th,table.t.compact td{padding:4px 6px;font-size:13px}
table.t.grille-cases td,table.t.grille-cases th{border:1px solid #D0D5DD;text-align:center;padding:3px 4px}
.case{cursor:pointer;user-select:none;font-weight:600;min-width:34px}
.case.P{background:#ECFDF3;color:#067647}.case.A{background:#FEF3F2;color:#B42318}.case.X{background:#F2F4F7;color:#98A2B3;cursor:default}
.onglets{display:flex;gap:4px;border-bottom:1px solid var(--bord);margin-bottom:14px;flex-wrap:wrap}
.onglets a{padding:8px 14px;border:1px solid transparent;border-bottom:none;border-radius:8px 8px 0 0;color:var(--gris)}
.onglets a.actif{background:#fff;border-color:var(--bord);color:var(--bleu);font-weight:600;margin-bottom:-1px}
.zone-depot{border:2px dashed #2E6DA4;border-radius:12px;padding:30px;text-align:center;background:#F5F9FD;color:var(--bleu);cursor:pointer}
.zone-depot.survol{background:#E4EFFA}
.chart{width:100%;max-width:640px}
input[type=radio]{width:auto;margin-right:4px}
form.f label.choix,label.choix{display:inline-flex!important;align-items:center;gap:4px;font-weight:400!important;margin:4px 14px 4px 0!important}
.credit{margin-top:40px;padding-top:12px;border-top:1px solid var(--bord);text-align:center;font-size:12px;color:var(--gris)}
@media print{.credit{border:none;margin-top:10px}}

.btn[hidden],[hidden].btn{display:none!important}
.duo select{flex:0 0 auto;width:auto;max-width:48%}.duo input{flex:1;min-width:120px}

/* v1.6 : œil des champs mot de passe */
.mdp-cadre{position:relative;display:block}
.mdp-cadre input{width:100%;padding-right:2.6em;box-sizing:border-box}
.mdp-oeil{position:absolute;right:.3em;top:50%;transform:translateY(-50%);border:0;background:transparent;cursor:pointer;font-size:1.15em;line-height:1;padding:.2em .35em;color:#6B7A90;border-radius:6px}
.mdp-oeil.actif,.mdp-oeil:hover{color:#1F4E79;background:#E8EEF5}
/* v1.6 : capture photo — caméra avant / arrière et choix de l'appareil */
.pc-cams{font-size:12px;padding:3px 6px;max-width:220px}
/* v1.6 : planification mensuelle (CE-CM) */
table.t.plan-m th,table.t.plan-m td{font-size:12px;padding:3px 5px;vertical-align:top;border:1px solid #D0D5DD}
table.t.plan-m th.g{background:#E4ECF5;text-align:center}
table.t.plan-m td.champ{font-weight:600;background:#F9FAFB;text-align:center;vertical-align:middle}
table.t.plan-m td.sous{background:#FCFCFD;white-space:nowrap}
table.t.plan-m td.sous.vide,table.t.plan-m td.case.vide{background:#F2F4F7}
table.t.plan-m td.case{white-space:pre-line;min-width:120px}
table.t.plan-m td.case.gabarit{color:#98A2B3;font-style:italic}
table.t.plan-m textarea{width:100%;min-width:120px;min-height:34px;font-size:12px;padding:2px 4px;resize:vertical;box-sizing:border-box}
table.t.plan-m input[type=date]{font-size:11px;padding:2px 3px;width:118px}
.plan-m-sem{display:flex;gap:4px;align-items:center;flex-wrap:wrap;font-weight:400;font-size:11px}
/* ---------- v1.8 : saisies hors ligne, nouvelle version, accueil par rôle, Ma classe, appel rapide ---------- */
.bandeau.attente{background:#FFFAEB;border-bottom-color:#FEC84B;color:#93370D;text-decoration:none;font-weight:600}
.bandeau.maj{background:#ECFDF3;border-bottom-color:#ABEFC6;color:#067647}
.raccourcis{display:grid;grid-template-columns:repeat(auto-fill,minmax(170px,1fr));gap:12px;margin:6px 0 18px}
.raccourcis a{display:flex;flex-direction:column;gap:6px;align-items:flex-start;justify-content:center;min-height:86px;
  border:1px solid #D0D5DD;border-radius:14px;padding:12px 14px;background:#fff;color:#1D2939;text-decoration:none;
  box-shadow:0 1px 2px rgba(16,24,40,.05)}
.raccourcis a:hover,.raccourcis a:focus-visible{border-color:#1F4E79;background:#F5F8FC}
.raccourcis .ico{font-size:26px;line-height:1}
.raccourcis b{font-size:15px;color:#1F4E79}
.raccourcis .d{font-size:12px;color:#667085}
.raccourcis a.alerte{border-color:#FDA29B;background:#FEF3F2}
.mc-classes{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:12px}
.mc-carte{border:1px solid #D0D5DD;border-radius:14px;background:#fff;padding:14px}
.mc-carte h2{margin:0 0 6px;font-size:18px}
.mc-ligne{display:flex;justify-content:space-between;gap:8px;font-size:14px;padding:3px 0;border-bottom:1px dashed #EAECF0}
.mc-ligne:last-child{border-bottom:0}
.puce{display:inline-block;border-radius:10px;padding:1px 8px;font-size:12px;font-weight:600}
.puce.ok{background:#ECFDF3;color:#067647}.puce.moy{background:#FFFAEB;color:#B54708}.puce.ko{background:#FEF3F2;color:#B42318}.puce.na{background:#F2F4F7;color:#667085}
.appel-rapide .compteurs{position:sticky;top:0;z-index:4;display:flex;gap:8px;flex-wrap:wrap;align-items:center;background:#fff;
  padding:8px 0;border-bottom:1px solid #EAECF0;margin-bottom:8px}
.appel-rapide .compteurs .c{border-radius:10px;padding:6px 12px;font-weight:700}
.appel-rapide .c.p{background:#ECFDF3;color:#067647}.appel-rapide .c.a{background:#FEF3F2;color:#B42318}.appel-rapide .c.r{background:#FFFAEB;color:#B54708}
.appel-rapide tr[data-eleve] td.nom{cursor:pointer;user-select:none;min-width:180px}
.appel-rapide tr.statut-absent td.nom{text-decoration:line-through;color:#B42318}
.appel-rapide tr.statut-retard td.nom{color:#B54708}
.groupe-rem{border:1px solid #D0D5DD;border-radius:12px;padding:10px 12px;margin:8px 0;background:#fff}
.groupe-rem h3{margin:0 0 4px;font-size:15px}
.groupe-rem.g1{border-left:6px solid #D92D20}.groupe-rem.g2{border-left:6px solid #F79009}.groupe-rem.g3{border-left:6px solid #17B26A}.groupe-rem.g4{border-left:6px solid #2E90FA}
.alerte-l{display:flex;gap:10px;align-items:flex-start;border:1px solid #EAECF0;border-radius:10px;padding:8px 10px;margin:6px 0;background:#fff}
.alerte-l.haute{border-left:6px solid #D92D20}.alerte-l.moyenne{border-left:6px solid #F79009}.alerte-l.info{border-left:6px solid #2E90FA}
.alerte-l .ico{font-size:20px}
@media print{.noprint,.raccourcis{display:none!important}}
.alerte-l details summary{cursor:pointer;font-size:13px;color:#1F4E79}
.alerte-l ul{margin:6px 0 0 18px;padding:0;font-size:13px}

/* v1.12 : bouton « ← Retour » en haut de chaque page */
.retour-ligne{display:flex;gap:6px;margin:0 0 10px}
.btn-retour{display:inline-flex;align-items:center;gap:4px;border:1px solid #CBD5E1;background:#fff;color:#1F4E79;border-radius:18px;padding:5px 12px;font-size:.92em;cursor:pointer;text-decoration:none;font-weight:600}
.btn-retour:hover{background:#E8EEF5}.btn-retour.sec{color:#475467;font-weight:500}
@media print{.retour-ligne{display:none}}
/* 1.16 : départements servis — plusieurs choix */
.champ-deps{grid-column:1/-1}.champ-deps .lib-deps{display:block;font-weight:600;font-size:13px;margin:10px 0 4px}
.cases-deps{display:grid;grid-template-columns:repeat(auto-fill,minmax(130px,1fr));gap:4px 12px;border:1px solid var(--bord);border-radius:6px;padding:8px 10px;background:#fff}
.case-dep{display:flex;align-items:center;gap:6px;font-weight:400!important;margin:0!important;font-size:13.5px}
.case-dep input{width:auto}
/* ---- v1.17 : en-têtes fixes — la ligne des rubriques reste visible pendant le défilement ----
   Les tableaux larges ou longs défilent dans leur propre cadre (.tw) : en-tête collé en haut du cadre,
   première colonne collée à gauche quand le tableau déborde sur les côtés (téléphone). Hors cadre, l'en-tête
   se colle sous la barre du haut. Les titres de section des longs formulaires restent visibles aussi. */
.tw{overflow:auto;max-height:calc(100vh - 140px);max-height:calc(100dvh - 140px);overscroll-behavior:contain}
.tw.tw-libre{max-height:none}
table .th-fixe{position:sticky!important;z-index:4!important;background-clip:padding-box}
table .th-fixe::after{content:"";position:absolute;left:0;right:0;bottom:-1px;border-bottom:1px solid var(--bord);pointer-events:none}
table .col-fixe{position:sticky;left:0;z-index:2;background-clip:padding-box;box-shadow:1px 0 0 var(--bord)}
table .th-fixe.col-fixe,table .th-fixe[style*=left]{z-index:5!important}
main.travail form h2,main.travail form h3,main form .sec-titre,.titre-fixe{position:sticky;top:56px;z-index:6;background:var(--fond);padding-top:6px;padding-bottom:6px;margin-top:18px}
main.travail .carte form h2,main.travail .carte form h3,main.travail form .carte h2,main.travail form .carte h3{background:var(--carte)}
@media print{.tw{max-height:none!important;overflow:visible!important}table .th-fixe,table .col-fixe{position:static!important;box-shadow:none}
  main.travail form h2,main.travail form h3,.titre-fixe{position:static}}
/* v1.18 — Préparation de classe (programmes, guides, fiches APC) */
.prep-dl{display:grid;grid-template-columns:minmax(150px,240px) 1fr;gap:6px 14px;margin:10px 0}
.prep-dl dt{font-weight:600;color:#1F4E79}.prep-dl dd{margin:0}
@media (max-width:640px){.prep-dl{grid-template-columns:1fr}.prep-dl dd{margin-bottom:6px}}
.prep-deroul td{vertical-align:top}.prep-deroul td:first-child{width:18%}.prep-deroul td:last-child{width:24%}
.prep-form .grille-prep,.prep-form .grille-form{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:10px}
.prep-form label.bloc{display:block;margin:10px 0}.prep-form label.bloc input,.prep-form label.bloc textarea{width:100%;box-sizing:border-box}
.prep-form .prep-deroul textarea{width:100%;box-sizing:border-box;min-width:120px}
tr.prep-vide{display:none}
.prep-contenu table{border-collapse:collapse;width:100%;margin:8px 0}.prep-contenu td,.prep-contenu th{border:1px solid #98A2B3;padding:4px 6px;vertical-align:top}
.prep-semaine{margin-bottom:14px}
@media print{#menu,.onglets,.actions,.filtres{display:none!important}}

/* v1.25 : icônes au trait (dessins SVG, couleur du texte) à la place des émojis */
.icone{display:inline-block;vertical-align:-.18em;flex:none}.btn .icone{margin-right:3px}.ico .icone{vertical-align:middle}
/* v2.1 : programme en vigueur (mesures correctives) */
.bandeau-vigueur{border-left:4px solid #067647;background:#ECFDF3}
.badge-vigueur{display:inline-block;margin:6px 0;padding:3px 10px;border-radius:20px;font-weight:600;background:#ECFDF3;color:#067647}
.mat-filtres{display:flex;flex-wrap:wrap;gap:8px;align-items:end;margin:10px 0}
.mat-sem td{vertical-align:top}

/* v2.2 — barre « Télécharger PDF · Télécharger Word · Imprimer » (pédagogie et pages imprimables) */
.export-barre{display:flex;flex-wrap:wrap;gap:6px;justify-content:flex-end;margin:0 0 10px}
.export-barre .btn{white-space:nowrap}
@media (max-width:600px){.export-barre{justify-content:stretch}.export-barre .btn{flex:1 1 auto;text-align:center}}
@media print{.export-barre{display:none!important}}
